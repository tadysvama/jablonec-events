# ========================================
# DATABÁZOVÉ PŘIPOJENÍ
# ========================================
# Pro lokální vývoj použij jednu z možností:
#
# 1. Render Postgres (doporučeno – zdarma)
#    Získej connection string z dashboard.render.com → New + PostgreSQL
#    DATABASE_URL="postgresql://user:pass@dpg-xxx.frankfurt-postgres.render.com/dbname"
#
# 2. Neon (alternativa – také zdarma)
#    https://neon.tech → vytvoř projekt → zkopíruj "Connection string"
#    DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
#
# 3. Lokální Docker Postgres
#    docker run -d --name jbc-postgres -e POSTGRES_PASSWORD=devpass -p 5432:5432 postgres
#    DATABASE_URL="postgresql://postgres:devpass@localhost:5432/postgres"

DATABASE_URL="postgresql://user:password@host:5432/database"
